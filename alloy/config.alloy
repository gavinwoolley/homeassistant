prometheus.relabel "blackbox_icmp" {
  forward_to = [prometheus.remote_write.mimir.receiver]
  rule {
    source_labels = ["target"]
    target_label  = "instance"
  }
}

// --------------------------------------------
// Node Exporter - Remote Linux Hosts
// --------------------------------------------
// Raw node_exporter endpoints (no job label of their own), so the "job"
// target label is set explicitly to match the integrations/unix label that
// prometheus.exporter.unix emits for the local host. Keep all Linux hosts
// on one job name.
prometheus.scrape "node_exporter" {
  targets = [
    {"__address__" = "homer_simpson-hp-laptop:9100", "instance" = "dev-linux", "job" = "integrations/unix"},
  ]
  forward_to      = [prometheus.relabel.node_exporter.receiver]
  scrape_interval = "30s"
  job_name        = "integrations/unix"
}

// dev-linux is a laptop VM that goes up and down - tag it so the Alertmanager
// routes its alerts to the low-priority "transient" receiver instead of paging.
prometheus.relabel "node_exporter" {
  forward_to = [prometheus.remote_write.mimir.receiver]
  rule {
    source_labels = ["instance"]
    regex         = "dev-linux"
    target_label  = "tier"
    replacement   = "transient"
  }
}

// --------------------------------------------
// Windows Exporter - VM Host Metrics
// --------------------------------------------
prometheus.scrape "windows" {
  targets = [
    {"__address__" = "homer_simpson-hp-laptop:9182", "server" = "homer_simpson-hp-laptop"},
    {"__address__" = "server1:9182",         "server" = "server1"},
    {"__address__" = "server2:9182",         "server" = "server2"},
    {"__address__" = "server3:9182",         "server" = "server3"},
    {"__address__" = "blueiris:9182",        "server" = "blueiris"},
    {"__address__" = "plex01:9182",          "server" = "plex01"},
  ]
  forward_to      = [prometheus.relabel.windows.receiver]
  scrape_interval = "30s"
  job_name        = "windows"
}

prometheus.relabel "windows" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    source_labels = ["server"]
    target_label  = "instance"
  }

  // Laptop that's frequently powered off - route its alerts to the
  // low-priority "transient" receiver in the Alertmanager, not the pager.
  // (homer_simpson-laptop was decommissioned and its scrape target removed above -
  // homer_simpson-hp-laptop is the only one left.)
  rule {
    source_labels = ["server"]
    regex         = "homer_simpson-hp-laptop"
    target_label  = "tier"
    replacement   = "transient"
  }

  // windows_service_*/scheduled_task_*/process_* are one series per Windows
  // service/task/process - hundreds of each x7 hosts. Measured at ~49500 of
  // the ~58700 total windows_* series, itself the largest single contributor
  // to Mimir hitting its 150000 max_global_series_per_user ceiling (confirmed
  // via err-mimir-max-series-per-user rejections). None of it is used except
  // windows_service_state for the 2 services WindowsServiceNotRunning
  // actually watches - tag those, then drop the rest of these 3 families.
  rule {
    action        = "replace"
    source_labels = ["__name__", "name"]
    regex         = "windows_service_state;(blueiris|plexmediaserver)"
    target_label  = "__keep_series__"
    replacement   = "yes"
  }
  rule {
    action        = "drop"
    source_labels = ["__name__", "__keep_series__"]
    regex         = "(windows_service_.*|windows_scheduled_task_.*|windows_process_.*);"
  }
  rule {
    action = "labeldrop"
    regex  = "__keep_series__"
  }
}
