{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Compares the running version of LGTM stack components (Grafana, Loki, Mimir) against the latest GitHub release, and shows release notes.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 4,
          "links": [],
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "/^version_clean$/",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "repeat": "app",
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "max by (version_clean) (\r\n  label_replace(\r\n    {__name__=~\"${app}_build_info\"},\r\n    \"version_clean\",\r\n    \"$1\",\r\n    \"version\",\r\n    \"^v?(.*)$\"\r\n  )\r\n)\r\n",
          "format": "table",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "$app Version",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${github_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^name$/",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "repeat": "app",
      "repeatDirection": "h",
      "targets": [
        {
          "columns": [
            {
              "selector": "tag_name",
              "text": "tag_name",
              "type": "string"
            },
            {
              "selector": "name",
              "text": "name",
              "type": "string"
            },
            {
              "selector": "published_at",
              "text": "published_at",
              "type": "string"
            },
            {
              "selector": "html_url",
              "text": "html_url",
              "type": "string"
            },
            {
              "selector": "body",
              "text": "body",
              "type": "string"
            }
          ],
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${github_datasource}"
          },
          "filters": [],
          "format": "table",
          "global_query_id": "",
          "parser": "backend",
          "refId": "A",
          "root_selector": "[\n  {\n    \"tag_name\": tag_name,\n    \"name\": ($substring(name,0,1) = \"v\") ? $substring(name,1) : name,\n    \"published_at\": published_at,\n    \"html_url\": html_url,\n    \"body\": body\n  }\n]\n",
          "source": "url",
          "type": "json",
          "url": "/repos/grafana/$app/releases/latest",
          "url_options": {
            "data": "",
            "method": "GET"
          }
        }
      ],
      "title": "$app Latest Release",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${github_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 10,
      "options": {
        "afterRender": "",
        "content": "## {{tag_name}}\n_Published {{published_at}}_\n\n<a href=\"{{html_url}}\" target=\"_blank\" rel=\"noopener noreferrer\">\nView on GitHub\n</a>\n\n---\n\n{{{body}}}\n",
        "contentPartials": [],
        "defaultContent": "The query didn't return any results.",
        "editor": {
          "format": "auto",
          "language": "markdown"
        },
        "editors": [],
        "externalStyles": [],
        "helpers": "",
        "renderMode": "everyRow",
        "styles": "",
        "wrap": true
      },
      "pluginVersion": "6.2.0",
      "repeat": "app",
      "repeatDirection": "h",
      "targets": [
        {
          "columns": [
            {
              "selector": "tag_name",
              "text": "tag_name",
              "type": "string"
            },
            {
              "selector": "name",
              "text": "name",
              "type": "string"
            },
            {
              "selector": "published_at",
              "text": "published_at",
              "type": "string"
            },
            {
              "selector": "html_url",
              "text": "html_url",
              "type": "string"
            },
            {
              "selector": "body",
              "text": "body",
              "type": "string"
            }
          ],
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${github_datasource}"
          },
          "filters": [],
          "format": "timeseries",
          "global_query_id": "",
          "parser": "backend",
          "refId": "A",
          "root_selector": "$",
          "source": "url",
          "type": "json",
          "url": "/repos/grafana/$app/releases/latest",
          "url_options": {
            "data": "",
            "method": "GET"
          }
        }
      ],
      "title": "$app Changes",
      "type": "marcusolsson-dynamictext-panel"
    }
  ],
